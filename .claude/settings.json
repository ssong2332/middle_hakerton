{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "node .claude/hooks/block-main-writes.js" },
          { "type": "command", "command": "node .claude/hooks/block-no-verify.js" },
          { "type": "command", "command": "node .claude/hooks/block-env-access.js" }
        ]
      },
      {
        "matcher": "Read|Edit|Write|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "node .claude/hooks/block-env-access.js" }
        ]
      }
    ]
  }
}

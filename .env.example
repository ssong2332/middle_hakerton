# Copy this file to .env and fill in real values.
# Never commit .env — only this file (.env.example) is tracked in git.
#
# 항목 출처: docs/Architecture.md Security "Secrets & configuration" · Deployment
# "Configuration per environment"(2026-08-04 확정). 값은 여기 절대 쓰지 않는다 — 이름만 플레이스홀더.
# ✅ T3(2026-08-04) — Supabase 프로젝트 확인 완료(기존 프로젝트 재사용, 사용자 결정). 실제 URL/anon key는
# 오케스트레이터가 채팅으로 전달했다 — 이 파일에는 절대 쓰지 않는다. 각자 로컬 .env에 직접 채운다.

# OpenAI API 키 — 서버 전용. NEXT_PUBLIC_ 접두사를 붙이지 않는다(붙이면 클라이언트 번들에 노출되어 AC-030 위반).
OPENAI_API_KEY=

# 사용할 모델명. 등급을 낮출 때 재배포만으로 끝나도록 코드에 박지 않는다.
OPENAI_MODEL=

# Supabase 프로젝트 URL — 클라이언트에서 쓰이므로 NEXT_PUBLIC_ 접두사가 붙는다.
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon key — 클라이언트 노출 전제(RLS가 인가를 강제).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key — 🔴 서버 전용, RLS 우회. apps/web/lib/supabase/server.ts의
# createServiceClient() 한 곳(llm_cache · llm_call_log 접근 전용)에서만 쓴다.
SUPABASE_SERVICE_ROLE_KEY=

# 요청 상한(AC-041) — 사용자·일 단위 / 전역·일 단위 두 겹.
MAX_LLM_CALLS_PER_USER_PER_DAY=
MAX_LLM_CALLS_GLOBAL_PER_DAY=

# ─────────────────────────────────────────────────────────────────────────
# 🔴 선택 항목 — 로컬 테스트 전용(정식 아키텍처 결정 아님, apps/web/lib/llm/gemini.ts 참조).
# 팀 OpenAI API 키를 아직 쓸 수 없는 동안 개발자 로컬 환경에서만 Gemini로 바꿔 실행해 보기
# 위한 임시 스위치다. 셋 다 비워두면(=미설정) 지금처럼 항상 OpenAI를 쓴다 — Vercel
# 프로덕션에는 이 셋을 설정하지 않는다.

# 'gemini'로 설정하면 apps/web/lib/llm/gemini.ts(LLMClient 구현체)를 쓴다. 그 외/미설정이면
# 항상 OpenAI(apps/web/lib/llm/openai.ts)를 쓴다.
LLM_PROVIDER=

# Gemini API 키 — 서버 전용. NEXT_PUBLIC_ 접두사를 붙이지 않는다. LLM_PROVIDER=gemini일 때만 쓰인다.
GEMINI_API_KEY=

# 사용할 Gemini 모델명(예: gemini-2.5-flash). LLM_PROVIDER=gemini일 때만 쓰인다.
GEMINI_MODEL=

# ─────────────────────────────────────────────────────────────────────────
# Chrome 확장(T56) — `docs/Architecture.md` "확장 인증". 개발자 모드 로드 전용
# (Planning Decision #4) — 값은 로컬에서 직접 채운다. 둘 다 새 변수이며 DECISIONS.md 대상인
# "신규 의존성"이 아니라 신규 환경변수라 별도 승인 없이 여기(+ README)에만 문서화한다.

# 우리 앱 자신의 origin(예: http://localhost:3000, 또는 배포된 https://*.vercel.app 값). 확장의
# 콘텐츠 스크립트는 host 페이지의 origin에서 실행되므로 POST /api/mediate를 상대경로로 부르면
# 우리 앱이 아니라 그 host 페이지를 가리키게 된다 — 그래서 절대 URL이 필요하다. 빌드 시
# apps/extension/manifest.json의 externally_connectable.matches/host_permissions에도 이 값으로
# 채워 넣는다(apps/extension/vite.background.config.ts). apps/extension의 Vite 빌드(VITE_ 접두사만
# 클라이언트 번들에 노출)가 읽는다 — Next.js의 NEXT_PUBLIC_과 같은 역할이지만 Vite가 강제하는
# 접두사라 이름이 다르다.
VITE_APP_ORIGIN=

# apps/web/app/extension/connect/page.tsx가 chrome.runtime.sendMessage(EXTENSION_ID, ...)로
# 로그인 토큰을 확장에 넘길 때 대상으로 삼는 확장 ID. 개발자 모드로 압축 해제 확장을 로드한 뒤
# chrome://extensions 에서 복사해 채운다(로드 경로/프로필마다 값이 다를 수 있음 — Planning
# Decision #4, 개발자 모드 로드 전용 MVP 전제). 브라우저(클라이언트)에서 쓰이므로 NEXT_PUBLIC_
# 접두사가 필요하다.
NEXT_PUBLIC_EXTENSION_ID=

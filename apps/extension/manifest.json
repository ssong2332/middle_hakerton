{
  "manifest_version": 3,
  "name": "크로스보더 협업 중재",
  "version": "0.0.0",
  "description": "선택한 텍스트를 즉시 중재한다 (개발자 모드 로드 전용 — Planning Decision #4).",
  "permissions": ["activeTab", "storage"],
  "host_permissions": [],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "externally_connectable": {
    "matches": []
  }
}
